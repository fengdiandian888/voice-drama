   }
  ],
  "scene": "极短视频，“哥哥”指出对方装病逃避惩罚，扬言要“收拾”。含轻度管娇语气。",
  "behaviors": [
   {
    "desc": "揭穿对方装病逃罚，表明要予以惩戒"
   }
  ],
  "tone_summary": "（自动）他视角独白，语气以命令、平静为主，题材偏现代情侣。",
  "genre_tags": [
   "现代情侣"
  ],
  "emotion_arc": "（自动）命令→平静",
  "intensity": "中",
  "listener_role": "（自动）被他倾诉/照顾/管教的一方（你）",
  "signature_elements": [
   "惩罚"
  ],
  "sensitive": false,
  "tier": "auto",
  "speaker_confident": false,
  "story": [
   {
    "type": "narr",
    "text": "他坐在沙发上，看着那个裹着毯子、虚弱兮兮的人，语气带着看穿一切的了然。"
   },
   {
    "type": "line",
    "speaker": "他",
    "text": "本事见长啊，都学会装病逃避惩罚了。今天我倒要看看，你能装到什么时候。"
   },
   {
    "type": "narr",
    "text": "她缩了缩脖子，把脸埋进毯子里。他走过去，居高临下地看着她，慢悠悠地补充了一句。这一天的账，看来是怎么也躲不掉了。"
   }
  ]
 },
 {
