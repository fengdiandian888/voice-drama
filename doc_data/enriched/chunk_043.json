   }
  ],
  "tone_summary": "（自动）他视角独白，语气以平静、命令为主，题材偏现代情侣。",
  "genre_tags": [
   "现代情侣"
  ],
  "emotion_arc": "（自动）平静→命令",
  "intensity": "中",
  "listener_role": "（自动）被他倾诉/照顾/管教的一方（你）",
  "signature_elements": [],
  "sensitive": false,
  "tier": "auto",
  "speaker_confident": false,
  "story": [
   {
    "type": "narr",
    "text": "她摔坐在地上，膝盖擦破了皮，怎么都站不起来。他站在几步外，没有伸手，声音淡淡的。"
   },
   {
    "type": "line",
    "speaker": "他",
    "text": "既然自己站不起来了，那就爬过来。爬到我脚边，我就原谅你。"
   },
   {
    "type": "narr",
    "text": "她咬着唇，犹豫了一瞬，还是慢慢爬过去，停在他脚边，仰起头。他低头看她，眼底终于有了温度，伸手把人拉起来。"
   }
  ]
 },
