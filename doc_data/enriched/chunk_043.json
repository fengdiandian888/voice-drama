  "lines": [
   {
    "ts": "00:00:00",
    "text": "可以求饶，",
    "speaker": "主人",
    "tone": "平静",
    "sound": []
   },
   {
    "ts": "00:00:02",
    "text": "但是不准拒绝主人。",
    "speaker": "主人",
    "tone": "命令",
    "sound": []
   },
   {
    "ts": "00:00:04",
    "text": "为什么？",
