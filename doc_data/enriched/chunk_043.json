  ],
  "emotion_arc": "（自动）平静",
  "intensity": "中",
  "listener_role": "（自动）被主人倾诉/照顾/管教的一方（你）",
  "signature_elements": [],
  "sensitive": false,
  "tier": "auto",
  "speaker_confident": true,
  "story": [
   {
    "type": "narr",
    "text": "她趴好，声音带着哭腔求他轻一点。他语气不变，却把道理说得很清楚。"
   },
   {
    "type": "line",
    "speaker": "主人",
    "text": "可以求饶，但是不准拒绝主人。为什么？因为求饶的话，免罚就是主人赏你的。而拒绝——你没有这个权力。只会被打得更狠。趴好。一下，两下。继续数，不准停。"
   },
   {
    "type": "narr",
    "text": "她带着哭腔，一声一声地数着。他听着她越来越抖的声音，手里的力道却始终没有乱。求饶是撒娇，拒绝是违抗——这个分寸，她今天终于记住了。"
   }
  ]
