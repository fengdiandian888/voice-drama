    "tone": "平静",
    "sound": []
   },
   {
    "ts": "00:00:07",
    "text": "因为求饶的话，",
    "speaker": "主人",
    "tone": "平静",
    "sound": []
   },
   {
    "ts": "00:00:09",
    "text": "免罚就是主人赏你的。",
    "speaker": "主人",
    "tone": "责备",
